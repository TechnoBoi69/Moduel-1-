# Nested Conditional Statements: Conditional statement placed inside another if, elif, or else block, allowing for more complex decision-making based on multiple conditions.
# example:
num = 15
if num > 0:
    if num % 2 == 0:
        print("The number is positive and even")
    elif num == 0:
        print("The number is positive and odd")
    else:
        print("The number is not positive")
    

# Final Challenge: Write a program where the user has to guess a secret number between 1 and 10. The program should provide feedback if the guess is too high or too low and congratulate the user if they guess correctly.
# Hint: Remember that RANDOM module we used a few lessons ago? It would be extremely helpful here...
# Steps:
# 1. Randomly select a secret number between 1-10.
# 2. Ask the user to make a guess between 1-10.
# 3. If theuser is correct, print "congradulations, You guessed the secret number!"
# 4. if the user is too low, print "Too Low!"
# 5. If the user is too high, print "Too High!"

import random

secret_num = random.randint(1,10)
guess = int(input('Make a guess between 1-10:'))

if(secret_num == guess):
    print('Congradulations, You guessed the secret number!')
elif(guess < secret_num):
    print('Too Low!')
else:
    print('Too High!')

